{
  "diagnoser_name": "copilot-luna-compat",
  "provider": "command",
  "command_env_var": "DIAGNOSIS_COMMAND",
  "command_override": null,
  "prompt_path": "prompts/debugger_v1.md",
  "model": {
    "provider_name": "github-copilot",
    "model_name": "gpt-5.6-luna",
    "requested_alias": "gpt-5.6-luna",
    "expected_resolved_model": "gpt-5.6-luna",
    "env_var_name": "CILOGBENCH_COPILOT_MODEL",
    "model_version": null,
    "temperature": null,
    "top_p": null,
    "max_output_tokens": null,
    "json_mode": false,
    "deterministic": false,
    "tool_use": false
  },
  "context_policy": {
    "allow_raw_context": true,
    "max_context_tokens": 120000,
    "max_context_chars": 480000,
    "on_context_too_large": "provider_error",
    "allow_truncation": false
  },
  "reasoning": {"effort": "low"},
  "copilot": {"context_mode": "default", "tools_available": 0},
  "privacy": {
    "requires_explicit_external_llm_opt_in": true,
    "explicit_opt_in_env_var": "CILOGBENCH_ALLOW_EXTERNAL_LLM",
    "redaction_mode": "audit_only",
    "allow_secret_values_in_results": false
  },
  "provider_policy": {
    "non_fatal_provider_error_prefixes": ["unsupported_context_too_large"]
  },
  "cache_key_env": [
    "CILOGBENCH_COPILOT_CONTEXT_MODE",
    "CILOGBENCH_COPILOT_MAX_CONTEXT_CHARS",
    "CILOGBENCH_COPILOT_MODEL",
    "CILOGBENCH_COPILOT_REASONING_EFFORT"
  ]
}
