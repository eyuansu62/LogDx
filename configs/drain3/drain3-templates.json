{
  "method": "drain3-templates",
  "drain3_version": "0.9.11",
  "configuration_scope": "one fixed corpus-wide configuration",
  "sim_th": 0.4,
  "depth": 4,
  "max_children": 100,
  "max_clusters": null,
  "parametrize_numeric_tokens": true,
  "masking": [],
  "output_order": "first_occurrence_then_template",
  "output_format": "COUNT=<n> TEMPLATE_PART=<i>/<total> <drain_template_chunk>",
  "max_output_line_chars": 7000,
  "chunk_overlap_chars": 128,
  "line_mapping_available": false
}
